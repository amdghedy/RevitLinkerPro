<Window x:Class="RevitLinkManagerUltra.AdvancedSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Manager Ultra - Selection Method" 
        Height="250" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="How would you like to select files?" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,15">
            <RadioButton Name="FileSelectionRadio" Content="Select individual files" 
                        IsChecked="True" Margin="0,0,0,10"/>
            <RadioButton Name="FolderSelectionRadio" Content="Scan folders and subfolders" 
                        Margin="0,5,0,0"/>
        </StackPanel>

        <CheckBox Grid.Row="2" Name="IncludeSubfoldersCheckBox" 
                 Content="Include subfolders in scan" 
                 IsChecked="True" Margin="0,0,0,15"
                 IsEnabled="{Binding ElementName=FolderSelectionRadio, Path=IsChecked}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" 
                    Width="80" Margin="0,0,10,0"/>
            <Button Content="Continue" Click="Continue_Click" 
                    Width="80" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>